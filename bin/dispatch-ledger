#!/usr/bin/env python3
"""Append one row to the dispatch ledger.

Stdlib only, so it runs on any machine with python3 on PATH. See README.md
for the ledger's column reference and where the file lives.
"""
import argparse
import os
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

HEADER = [
    "ts", "plan_path", "task_idx", "task_text", "impl_status", "impl_loops",
    "spec_review", "spec_loops", "quality_review", "quality_loops",
    "final_status", "model_impl", "notes",
]

# Strict enums for impl_status and final_status: both are closed sets in
# practice, so a typo here is almost certainly a caller bug and is rejected
# outright.
IMPL_STATUS_CHOICES = ["DONE", "DONE_WITH_CONCERNS", "NEEDS_CONTEXT", "BLOCKED"]
FINAL_STATUS_CHOICES = ["complete", "escalated", "user"]

# spec_review and quality_review are NOT closed sets: real runs record
# free-form annotations alongside the usual PASS/FAIL/CRITICAL/IMPORTANT/
# SKIPPED values, such as "FAIL->PASS" (recovered after a re-review) or
# "n/a (docs task; ...)" (a stage that does not apply to a non-code task).
# Rejecting anything outside a fixed enum would reject legitimate outcomes,
# so these two fields only require non-empty text.

_O_BINARY = getattr(os, "O_BINARY", 0)  # 0 on POSIX; see append_row().


class OneLineArgumentParser(argparse.ArgumentParser):
    """Bad input must fail loud but short: one line on stderr, no multi-line
    usage block. argparse's default error() prints print_usage() first and
    then the "prog: error: ..." line; this skips the usage block and keeps
    only that second line, still on stderr, still exit status 2 (argparse's
    own usage-error status; the only other non-zero exit this tool has is 1,
    for a write failure in main()).

    add_subparsers() defaults parser_class to type(self), so the "append"
    subparser created from a OneLineArgumentParser instance is itself a
    OneLineArgumentParser and inherits this override automatically -- an
    invalid --impl-status or a missing --plan is detected on that subparser,
    not the top-level one, and needs the same fix.
    """

    def error(self, message):
        self.exit(2, f"{self.prog}: error: {message}\n")


def default_ledger_path():
    env = os.environ.get("DISPATCH_LEDGER")
    if env:
        return Path(env)
    return Path.home() / ".claude" / "dispatch" / "runs.tsv"


def sanitize(value):
    """Collapse tabs/newlines to single spaces so a row is always exactly
    len(HEADER) columns, and launder any byte sequence argv could not
    decode as UTF-8.

    sys.argv is decoded with the surrogateescape error handler, so an
    argument built from bytes that are not valid UTF-8 (a mangled locale, a
    byte copied in from another encoding) carries lone surrogate
    codepoints. Encoding that straight back to UTF-8 -- which every row
    write in this file does -- raises UnicodeEncodeError, so one bad byte
    in a caller's argument would otherwise crash the whole append.
    Round-tripping through a surrogateescape encode and then a replace
    decode turns each invalid byte into U+FFFD and leaves every valid
    character untouched, so the row is still recorded.
    """
    value = value.encode("utf-8", "surrogateescape").decode("utf-8", "replace")
    return (
        value.replace("\t", " ")
        .replace("\r\n", " ")
        .replace("\n", " ")
        .replace("\r", " ")
    )


def non_negative_int(raw):
    try:
        value = int(raw)
    except ValueError:
        raise argparse.ArgumentTypeError(f"expected an integer, got {raw!r}")
    if value < 0:
        raise argparse.ArgumentTypeError(f"expected a non-negative integer, got {value}")
    return value


def non_empty(raw):
    if not raw.strip():
        raise argparse.ArgumentTypeError("must not be empty")
    return raw


def build_parser():
    parser = OneLineArgumentParser(
        prog="dispatch-ledger",
        description="Append one run to the dispatch ledger.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    append = sub.add_parser("append", help="Append one row to the ledger.")
    append.add_argument(
        "--plan", required=True, type=non_empty,
        help="Plan file path, or a sentinel such as inline:<slug> for a plan with no file.",
    )
    append.add_argument(
        "--task", required=True, type=non_empty,
        help="Task index within the plan. Free text: real plans use values like 3, 17b, 13+14.",
    )
    append.add_argument("--text", required=True, type=non_empty, help="Task spec text or a summary of it.")
    append.add_argument("--impl-status", required=True, choices=IMPL_STATUS_CHOICES)
    append.add_argument("--impl-loops", required=True, type=non_negative_int)
    append.add_argument(
        "--spec-review", required=True, type=non_empty,
        help="PASS, FAIL, or a free-form outcome such as 'FAIL->PASS' or 'n/a (...)'.",
    )
    append.add_argument("--spec-loops", required=True, type=non_negative_int)
    append.add_argument(
        "--quality-review", required=True, type=non_empty,
        help="PASS, CRITICAL, IMPORTANT, SKIPPED, or a free-form outcome such as 'n/a (...)'.",
    )
    append.add_argument("--quality-loops", required=True, type=non_negative_int)
    append.add_argument("--final-status", required=True, choices=FINAL_STATUS_CHOICES)
    append.add_argument(
        "--model", required=True, type=non_empty,
        help="Model tier(s) used, e.g. sonnet, opus, haiku+sonnet.",
    )
    append.add_argument("--notes", default="", help="Free text. Defaults to '-' when omitted or empty.")

    return parser


def write_all(fd, data):
    """os.write can perform a short write (a full disk, a large write cut
    short by a signal); looping until every byte lands, and raising if a
    call makes zero progress instead of spinning forever, turns a partial
    write into a clean failure (caught by main() as a one-line exit 1)
    instead of a torn row that the next append would glue onto."""
    view = memoryview(data)
    while view:
        n = os.write(fd, view)
        if n == 0:
            raise OSError("write() made no progress (disk full?)")
        view = view[n:]


def ensure_ledger_header(path):
    """Create the ledger with just its header if it does not already exist.

    A single process using O_CREAT|O_EXCL to write header-plus-row together
    at offset 0 is not enough: that first write is not itself an append, so
    a second process's row -- appended in the gap between the first process
    opening the file and finishing that write -- can land before the header
    write completes, or the header can end up on line 2. Splitting "create
    the file" from "write a row" into two separately-atomic steps closes
    this: write the header to a temp file in the same directory, then
    os.link() it into place. Hard-linking is atomic and fails with
    FileExistsError if the destination already exists, so exactly one
    process's temp file ever becomes the ledger, no matter how many
    processes race here. Every row after that -- including the very first
    one, from whichever process won -- goes through append_row()'s single
    O_APPEND path, so there is only one way any row is ever written.

    The common case skips all of this: once the ledger exists, there is
    nothing left to do, and checking that first avoids creating a temp file
    on every single append.
    """
    if path.exists():
        return

    path.parent.mkdir(parents=True, exist_ok=True)
    header_line = ("\t".join(HEADER) + "\n").encode("utf-8")

    fd, tmp_name = tempfile.mkstemp(dir=str(path.parent), prefix=".dispatch-ledger-tmp-")
    try:
        write_all(fd, header_line)
        os.close(fd)
        fd = -1
        try:
            os.link(tmp_name, str(path))
        except FileExistsError:
            pass  # another process's temp file won the race; the ledger exists
        except OSError as exc:
            # No hard-link support on this filesystem (some network mounts).
            # There is no other primitive here that creates a file and
            # populates it in one atomic step, so there is no safe fallback:
            # an exclusive create followed by a SEPARATE, non-append header
            # write reintroduces exactly the race this function exists to
            # close (a second writer's row can land, via append_row()'s own
            # O_APPEND open, in the gap between the create and the header
            # write, and then be overwritten when the header write lands at
            # offset 0). Failing loudly here is safer than a fallback that
            # silently drops a row on a filesystem exotic enough to reach
            # this branch at all.
            raise OSError(
                f"cannot create it safely on this filesystem (no hard links): {exc}; "
                f"point DISPATCH_LEDGER at a local disk"
            ) from exc
    finally:
        if fd != -1:
            os.close(fd)
        try:
            os.unlink(tmp_name)
        except OSError as exc:
            print(f"dispatch-ledger: warning: could not remove temp file {tmp_name}: {exc}", file=sys.stderr)


def append_row(path, fields):
    """Append one TSV row through the ledger's single O_APPEND path.

    Atomicity: opens with O_APPEND and writes the whole encoded line in one
    write_all() call (ordinarily a single os.write() syscall, since every
    row here is well under a page). A single write() to a regular file
    opened O_APPEND is not interleaved with another process's writes to the
    same file on Linux or macOS. On Windows, O_APPEND is emulated by the C
    runtime rather than guaranteed atomic by the OS, so two sessions
    appending at the exact same instant there do not carry the same
    guarantee -- ensure_ledger_header()'s hard-link step still prevents two
    processes from both creating the file, which is the race this exists
    to close.

    Torn-line guard: if a previous append was itself torn (a short write
    left a row with no trailing newline, most likely from a full disk),
    gluing the next row onto it would corrupt both. Before writing, this
    checks whether the ledger's last byte is already a newline; if it is
    not, it prepends one. Opening O_RDWR (rather than O_WRONLY) makes the
    current end-of-file and its last byte readable through this same fd
    without disturbing where the write lands -- O_APPEND reseeks to the
    true end-of-file for every write() regardless of the fd's read
    position, so a concurrent writer landing between this check and this
    write costs at most one extra blank line, which dispatch-stats skips
    silently rather than counting as malformed.
    """
    ensure_ledger_header(path)

    line = ("\t".join(sanitize(f) for f in fields) + "\n").encode("utf-8")

    fd = os.open(str(path), os.O_RDWR | os.O_APPEND | _O_BINARY)
    try:
        size = os.fstat(fd).st_size
        if size > 0:
            # os.pread would do this in one call but is POSIX-only; lseek
            # then read is the portable equivalent, and it does not disturb
            # where the write below lands (see the docstring above).
            os.lseek(fd, size - 1, os.SEEK_SET)
            last_byte = os.read(fd, 1)
            if last_byte != b"\n":
                line = b"\n" + line
        write_all(fd, line)
    finally:
        os.close(fd)


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)

    notes = args.notes if args.notes.strip() else "-"
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    fields = [
        ts, args.plan, args.task, args.text, args.impl_status, str(args.impl_loops),
        args.spec_review, str(args.spec_loops), args.quality_review, str(args.quality_loops),
        args.final_status, args.model, notes,
    ]

    if len(fields) != len(HEADER):
        print(
            f"dispatch-ledger: internal error: built {len(fields)} fields, expected {len(HEADER)}",
            file=sys.stderr,
        )
        return 1

    ledger_path = default_ledger_path()
    try:
        append_row(ledger_path, fields)
    except OSError as exc:
        print(f"dispatch-ledger: could not write to {ledger_path}: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
