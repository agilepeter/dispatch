#!/usr/bin/env python3
"""Print rolling N-day stats from a dispatch ledger.

Stdlib only, so it runs on any machine with python3 on PATH, plus a --json
flag for machine consumption. See README.md for the ledger's column
reference and the shape of --json output.
"""
import argparse
import csv
import json
import os
import sys
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

DEFAULT_DAYS = 30

HEADER = [
    "ts", "plan_path", "task_idx", "task_text", "impl_status", "impl_loops",
    "spec_review", "spec_loops", "quality_review", "quality_loops",
    "final_status", "model_impl", "notes",
]

MODEL_ORDER = ["haiku", "sonnet", "opus"]


class OneLineArgumentParser(argparse.ArgumentParser):
    """Bad input must fail loud but short: one line on stderr, no multi-line
    usage block. Same override as bin/dispatch-ledger's copy of this class;
    duplicated rather than imported so each script in bin/ stays a single
    standalone file with no sibling-import setup needed to run it."""

    def error(self, message):
        self.exit(2, f"{self.prog}: error: {message}\n")


class LedgerFormatError(Exception):
    """Raised when the ledger's header does not match the expected columns."""


def default_ledger_path():
    env = os.environ.get("DISPATCH_LEDGER")
    if env:
        return Path(env)
    return Path.home() / ".claude" / "dispatch" / "runs.tsv"


def non_negative_int(raw):
    try:
        value = int(raw)
    except ValueError:
        raise argparse.ArgumentTypeError(f"expected an integer, got {raw!r}")
    if value < 0:
        raise argparse.ArgumentTypeError(f"expected a non-negative integer, got {value}")
    return value


def parse_args(argv=None):
    p = OneLineArgumentParser(prog="dispatch-stats", description="Dispatch run stats")
    p.add_argument("--days", type=non_negative_int, default=DEFAULT_DAYS)
    p.add_argument("--input", type=Path, default=None, help="Defaults to $DISPATCH_LEDGER or ~/.claude/dispatch/runs.tsv")
    fmt = p.add_mutually_exclusive_group()
    fmt.add_argument("--oneline", action="store_true")
    fmt.add_argument("--json", action="store_true")
    return p.parse_args(argv)


def parse_ts(raw):
    """Parse an ISO-8601 timestamp and return it in UTC.

    A trailing "Z" means UTC but is stripped before parsing, since not
    every Python version this targets accepts it in fromisoformat()
    directly; the remainder is then treated as UTC. A timestamp with an
    explicit numeric offset (e.g. "+05:00") parses as an aware datetime
    that already carries that offset, and converting it with astimezone()
    is required there -- relabeling its tzinfo as UTC without converting
    would silently treat "14:03+05:00" as if it were "14:03Z", nine hours
    off. Only a genuinely naive timestamp (no offset, no trailing Z) is
    assumed to already be UTC.
    """
    if raw.endswith("Z"):
        dt = datetime.fromisoformat(raw[:-1]).replace(tzinfo=timezone.utc)
    else:
        dt = datetime.fromisoformat(raw)
        dt = dt.astimezone(timezone.utc) if dt.tzinfo else dt.replace(tzinfo=timezone.utc)
    return dt


def load_rows(path, cutoff):
    """Return (rows, skipped). A missing or empty ledger yields ([], 0)
    rather than raising, so a fresh install never crashes this tool. An
    unreadable path (a directory, permission denied) raises OSError, and a
    ledger whose header does not match the expected columns raises
    LedgerFormatError; main() turns either into a one-line stderr message
    and exit 1, since neither is a single bad row -- the whole file is
    unusable.

    Rows are read with csv.reader rather than csv.DictReader, and the
    column count is checked against the header BEFORE building a row dict:
    checking a DictReader row's own length would only ever catch a row
    with too MANY fields, because DictReader pads a short row's missing
    trailing fields with None instead of shrinking the dict -- a short row
    would sail through that check and then crash later trying to parse
    None as a number. Checking the raw field count first catches both
    directions, and a genuinely blank line (no fields at all) is not
    treated as a malformed row, just skipped silently.

    A row's loop-count fields are parsed and range-checked here too, so a
    row with garbage in a numeric column is counted as skipped like any
    other bad row instead of crashing the report several stages later.
    """
    if not path.exists():
        return [], 0

    skipped = 0
    rows = []
    # utf-8-sig strips a leading BOM if one is present, so a ledger saved by
    # an editor that adds one still reads its first header cell as "ts"
    # rather than "﻿ts", which would otherwise always fail the header
    # check below.
    with open(path, newline="", encoding="utf-8-sig") as f:
        # quoting=QUOTE_NONE: the writer (dispatch-ledger's sanitize())
        # already guarantees no field holds a tab or newline, so a plain
        # split on the delimiter is correct and sufficient. Without it,
        # csv's default quoting rules treat a field that STARTS with a
        # literal '"' as an open quote and read through following lines
        # looking for its close, silently merging other rows into it.
        reader = csv.reader(f, delimiter="\t", quoting=csv.QUOTE_NONE)
        try:
            header = next(reader)
        except StopIteration:
            return [], 0
        if header != HEADER:
            raise LedgerFormatError(
                f"dispatch-stats: {path}: header does not match the expected {len(HEADER)} columns"
            )
        for fields in reader:
            if not fields:
                continue  # a blank line is not a malformed row
            if len(fields) != len(header):
                skipped += 1
                continue
            row = dict(zip(header, fields))
            try:
                row_ts = parse_ts(row["ts"])
                for key in ("impl_loops", "spec_loops", "quality_loops"):
                    if int(row[key]) < 0:
                        raise ValueError(f"{key} must be non-negative")
            except (ValueError, KeyError):
                skipped += 1
                continue
            if row_ts >= cutoff:
                rows.append(row)
    return rows, skipped


def pct(num, denom):
    if denom == 0:
        return 0
    return round(num / denom * 100)


def avg(values):
    if not values:
        return 0.0
    return round(sum(values) / len(values), 1)


def compute_stats(rows, days, since):
    total = len(rows)
    impl_loops = [int(r["impl_loops"]) for r in rows]
    spec_loops = [int(r["spec_loops"]) for r in rows]
    quality_loops = [int(r["quality_loops"]) for r in rows]

    spec_fails = sum(1 for r in rows if r["spec_review"] == "FAIL")
    quality_criticals = sum(1 for r in rows if r["quality_review"] == "CRITICAL")
    escalations = sum(1 for r in rows if r["final_status"] == "escalated")

    model_counts = defaultdict(int)
    model_escalations = defaultdict(int)
    for r in rows:
        m = r["model_impl"]
        model_counts[m] += 1
        if r["final_status"] == "escalated":
            model_escalations[m] += 1

    plan_runs = defaultdict(int)
    plan_escalations = defaultdict(int)
    for r in rows:
        p = r["plan_path"]
        plan_runs[p] += 1
        if r["final_status"] == "escalated":
            plan_escalations[p] += 1

    top_plans = sorted(
        [(p, plan_escalations[p], plan_runs[p]) for p in plan_escalations if plan_escalations[p] >= 1],
        key=lambda x: (-x[1], -x[2]),
    )[:5]

    return {
        "days": days,
        "since": since,
        "total_runs": total,
        "avg_impl_loops": avg(impl_loops),
        "avg_spec_loops": avg(spec_loops),
        "avg_quality_loops": avg(quality_loops),
        "spec_fail_count": spec_fails,
        "spec_fail_rate_pct": pct(spec_fails, total),
        "quality_critical_count": quality_criticals,
        "quality_critical_rate_pct": pct(quality_criticals, total),
        "escalation_count": escalations,
        "escalation_rate_pct": pct(escalations, total),
        "by_model": [
            {
                "model": m,
                "runs": model_counts[m],
                "escalated": model_escalations[m],
                "escalation_rate_pct": pct(model_escalations[m], model_counts[m]),
            }
            for m in MODEL_ORDER
            if model_counts[m]
        ],
        "top_failing_plans": [
            {"plan_path": p, "escalations": esc, "runs": runs} for p, esc, runs in top_plans
        ],
    }


def print_oneline(stats):
    tier_parts = [f"{m['model']} {m['escalation_rate_pct']}%" for m in stats["by_model"]]
    tiers_str = ", ".join(tier_parts)
    print(
        f"Dispatch ({stats['days']}d): {stats['total_runs']} runs / {stats['avg_spec_loops']} avg spec_loops"
        f" / {stats['escalation_count']} escalated ({stats['escalation_rate_pct']}%)"
        + (f" | {tiers_str}" if tiers_str else "")
    )


def print_full(stats):
    rule = "─" * 49
    print(f"Dispatch health: last {stats['days']} days (since {stats['since']})")
    print(rule)
    print(f"Total task runs:        {stats['total_runs']}")
    print(f"Avg impl_loops:         {stats['avg_impl_loops']}")
    print(f"Avg spec_loops:         {stats['avg_spec_loops']}")
    print(f"Avg quality_loops:      {stats['avg_quality_loops']}")
    print(f"Spec FAIL rate:         {stats['spec_fail_rate_pct']}% ({stats['spec_fail_count']}/{stats['total_runs']})")
    print(f"Quality CRITICAL rate:  {stats['quality_critical_rate_pct']}% ({stats['quality_critical_count']}/{stats['total_runs']})")
    print(f"Escalation rate:        {stats['escalation_rate_pct']}% ({stats['escalation_count']}/{stats['total_runs']})")

    if stats["by_model"]:
        print()
        print("By model tier:")
        for m in stats["by_model"]:
            print(f"  {m['model']:<8}{m['runs']} runs   {m['escalated']} escalated   ({m['escalation_rate_pct']}%)")

    if stats["top_failing_plans"]:
        print()
        print("Top failing plans (by escalation count):")
        for p in stats["top_failing_plans"]:
            esc_word = "escalations" if p["escalations"] != 1 else "escalation "
            run_word = "runs" if p["runs"] != 1 else "run "
            print(f"  {p['plan_path']:<24}{p['escalations']} {esc_word} / {p['runs']} {run_word}")


def main(argv=None):
    args = parse_args(argv)
    input_path = args.input or default_ledger_path()

    now = datetime.now(timezone.utc)
    cutoff = now - timedelta(days=args.days)
    since = cutoff.strftime("%Y-%m-%d")

    try:
        rows, skipped = load_rows(input_path, cutoff)
    except LedgerFormatError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"dispatch-stats: {input_path}: {exc}", file=sys.stderr)
        return 1

    stats = compute_stats(rows, args.days, since)
    stats["skipped_rows"] = skipped
    if not rows:
        stats["message"] = "No dispatch runs logged yet."

    if args.json:
        print(json.dumps(stats, indent=2))
    elif not rows:
        print(stats["message"])
    elif args.oneline:
        print_oneline(stats)
    else:
        print_full(stats)

    if skipped:
        print(f"{skipped} malformed row(s) skipped.", file=sys.stderr)

    return 0


if __name__ == "__main__":
    sys.exit(main())
